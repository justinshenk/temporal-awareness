---
import BaseLayout from "../layouts/BaseLayout.astro";
import LayerAxis from "../components/LayerAxis.astro";
import ledger from "../data/evidence_ledger.json";
import { BASE, asset } from "../lib/site";

const { sources, questions } = ledger;
const results = questions.filter((question) => question.answer);
const papers = [sources.rios, sources.mraz];

const horizonScale = [
  ["Seconds", "#3078ed"],
  ["Minutes", "#199ed9"],
  ["Hours", "#33bab3"],
  ["Days", "#66cc80"],
  ["Weeks", "#a6d959"],
  ["Months", "#e6cc4d"],
  ["Years", "#f29940"],
  ["Decades", "#e66633"],
  ["Centuries", "#cc4033"],
  ["No horizon", "#596680"],
];

const limits = [
  {
    title: "No surface baseline for the probes",
    body: "Shuffled labels rule out chance, but no text-only baseline has been run on these datasets, and the same kind of baseline explained an apparent planning signal in generated code.",
  },
  {
    title: "No prompting baseline for the steering",
    body: "Asking for a short- or long-term answer might produce similar shifts. The strongest steering settings are also large perturbations.",
  },
  {
    title: "One model family, narrow tasks",
    body: "The two papers cover Qwen3 models with thinking disabled, mainly on choice tasks. Multi-turn and agentic settings are untested.",
  },
  {
    title: "Not yet a monitor",
    body: "No result here shows a probe flagging a change in advance. A related study of repetition looked for that lead time and found none.",
  },
];
---

<BaseLayout title="Temporal Awareness">
  <section class="mx-auto grid max-w-6xl items-center gap-x-12 gap-y-8 px-4 pb-12 pt-12 lg:grid-cols-12 lg:pt-16">
    <div class="lg:col-span-6">
      <p class="font-sans text-base text-ink-soft">How is time represented in LLMs?</p>
      <h1 class="font-display mt-4 text-4xl font-bold leading-[1.12] text-ink sm:text-5xl">
        Can we measure the time horizon behind a language model's output?
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-ink-soft">
        So far, a direction in the activations of two Qwen3 models can be read and steered, shifting outputs
        between short- and long-term options. In one of them, horizons from seconds to centuries form an ordered
        map. These results come mainly from choice tasks, and open-ended output has only a rough, unvalidated
        score so far.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 font-sans text-sm font-semibold">
        <a href={`${BASE}representation`} class="rounded-full bg-accent-800 px-6 py-3 text-white transition hover:bg-accent-700">
          Read the argument
        </a>
        <a href={`${BASE}evidence`} class="link-accent">See every number</a>
      </div>
    </div>
    <figure class="lg:col-span-6">
      <img
        src={asset("paper-figures/horizon-map.png")}
        alt="A scatter plot of model activations. Colored clusters run in order from seconds through minutes, hours, days, weeks, months, years and decades to centuries, with no-horizon samples in a separate gray cluster."
        width="1400"
        height="1165"
        class="paper-figure"
      />
      <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-sans text-xs text-ink-soft" aria-label="Color key, in order of horizon">
        {
          horizonScale.map(([label, color]) => (
            <li class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full" style={`background:${color}`} aria-hidden="true" />
              {label}
            </li>
          ))
        }
      </ul>
      <figcaption class="mt-3 font-sans text-sm leading-6 text-ink-soft">
        Time-horizon geometry in Qwen3-4B, projected with PCA. A projection shows structure, not a viewpoint inside
        the model. From <a class="link-accent" href={sources.rios.url}>{sources.rios.label}</a>, Figure 1.
      </figcaption>
    </figure>
  </section>

  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold text-ink">How does a time horizon become an output?</h2>
      <p class="mt-3 max-w-2xl text-lg leading-8 text-ink-soft">
        The current answer, step by step, with how much weight each step can carry.
      </p>
      <div class="mt-8 divide-y divide-rule border-y border-rule">
        {
          results.map((question) => (
            <a
              href={`${BASE}representation#${question.id}`}
              class="group grid gap-x-8 gap-y-2 py-5 md:grid-cols-12"
            >
              <h3 class="font-display text-lg font-bold leading-snug text-ink group-hover:text-accent-700 dark:group-hover:text-accent-400 md:col-span-3">
                {question.title}
              </h3>
              <p class="leading-7 text-ink-soft md:col-span-6">{question.answer}</p>
              <p class="font-sans text-sm font-medium leading-6 text-ink md:col-span-3">{question.strength}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold text-ink">Reading a signal and changing it are different tests</h2>
      <p class="mb-8 mt-3 max-w-2xl text-lg leading-8 text-ink-soft">
        In both studies, the layers with the best probe accuracy differ from the layers with the largest steering
        effect. A probe used for oversight has to track what affects the output, so accuracy alone isn't enough.
      </p>
      <LayerAxis />
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold text-ink">What these results don't show</h2>
      <div class="mt-8 grid gap-x-12 gap-y-7 md:grid-cols-2">
        {
          limits.map((limit) => (
            <div>
              <h3 class="font-display text-lg font-bold text-ink">{limit.title}</h3>
              <p class="mt-1 leading-7 text-ink-soft">{limit.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-lg leading-8 text-ink-soft">
        Each gap is open work. <a class="link-accent" href={`${BASE}contribute`}>See what you can pick up</a>.
      </p>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-display text-3xl font-bold text-ink">Papers</h2>
      <ul class="mt-6 space-y-6">
        {
          papers.map((paper) => (
            <li class="max-w-3xl">
              <a class="font-display text-lg font-bold text-ink underline decoration-rule underline-offset-4 hover:text-accent-700 dark:hover:text-accent-400" href={paper.url}>
                {paper.title}
              </a>
              <p class="mt-1 leading-7 text-ink-soft">{paper.authors}</p>
              <p class="font-sans text-sm text-ink-soft">{paper.venue}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
