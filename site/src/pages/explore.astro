---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExploreEmbed from "../components/ExploreEmbed.tsx";
import { BASE, REPO_URL } from "../lib/site";

const steps = [
  "Keep Color By on Time Horizon. Set Layer to Layer 31 and Component to Residual Post.",
  "In the Position panel, select the stated horizon, such as “1 second.”, and look at how the samples are arranged.",
  "Select the <|im_end|> token at the end of the prompt, then the “a)” token under Response, and compare.",
];
---

<BaseLayout title="Explore" description="An interactive view of time-horizon geometry in model activations.">
  <section class="mx-auto max-w-4xl px-4 pt-12">
    <h1 class="font-display text-4xl font-bold leading-tight text-ink">Explore the geometry</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-ink-soft">
      Rotate through PCA projections of model activations by layer, component and prompt position. This accompanies
      the sections on <a class="link-accent" href={`${BASE}representation#shape`}>horizon form</a> and
      <a class="link-accent" href={`${BASE}representation#when`}>the turn boundary</a>.
    </p>
    <ol class="mt-6 max-w-2xl list-decimal space-y-2 pl-6 leading-7 text-ink-soft">
      {steps.map((step) => <li>{step}</li>)}
    </ol>
    <p class="mt-5 max-w-2xl font-sans text-sm leading-6 text-ink-soft">
      The explorer loads 80 precomputed samples and 15 layers, not the full dataset behind the papers. L22 and L26
      aren't included, so it can't show the peak steering or probe layers from Qwen3-4B. Use it to build intuition,
      not as evidence.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-8">
    <ExploreEmbed client:load />
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 font-sans text-sm text-ink-soft">
    Built with React, Three.js and a FastAPI backend that serves precomputed embeddings.
    <a class="link-accent" href={`${REPO_URL}/tree/main/src/intertemporal/geoapp`}>View the source</a>.
  </section>
</BaseLayout>
