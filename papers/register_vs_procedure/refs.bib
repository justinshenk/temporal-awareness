@inproceedings{postmus2024conceptors,
  title     = {Steering Large Language Models using Conceptors: Improving Addition-Based
               Activation Engineering},
  author    = {Postmus, Joris and Abreu, Steven},
  booktitle = {NeurIPS 2024 Workshop on Foundation Model Interventions},
  year      = {2024},
  eprint    = {2410.16314},
  archivePrefix = {arXiv},
  note      = {Steering MATRICES as soft projections -- prior art for "matrix, not vector".
               VERIFIED input-conditional: h' = beta_c C h, so the shift depends on the current
               activation. Also closed-form, C(R,a) = R(R + a^-2 I)^-1 with R = X^T X / n.
               The distinction from ours is the TARGET, not the form or the fitting style:
               conceptors use a second moment of ONE activation set (no regression target,
               a shrinkage projection onto that set's ellipsoid); we use the CROSS moment
               X^T delta of PAIRED base/donor activations, i.e. supervision by a second model.},
}

@article{marshall2024ace,
  title   = {Refusal in LLMs is an Affine Function},
  author  = {Marshall, Thomas and Scherlis, Adam and Belrose, Nora},
  journal = {arXiv preprint},
  year    = {2024},
  eprint  = {2411.09003},
  archivePrefix = {arXiv},
  note    = {AFFINE CONCEPT EDITING (ACE). Closest prior art to our S4. Affine subspace
             projection + activation addition, 10 models incl. Llama-3-70B; reports the same
             incoherence failure mode we see in the fixed-vector baselines. Must be cited and
             distinguished in S4 -- ours is fit by regression onto a DONOR's delta, theirs is
             derived from an affine decomposition of the activation.},
}

